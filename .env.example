# --- Server ---
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/quizforge.db

# --- Nebius Token Factory (OpenAI-compatible) ---
# Get a key at https://tokenfactory.nebius.com  (leave empty to use the built-in offline question bank)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Any chat model enabled on your Nebius account (check the model list in the Token Factory console)
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
